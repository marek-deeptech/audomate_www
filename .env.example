# --- Lead notifications (Book a 4-week pilot form) ---
# Primary delivery: email via Resend to LEAD_NOTIFY_TO. Reply-to = the lead's email.
# Sender domain must be verified in the Resend account (veryniceworks.com is).
RESEND_API_KEY=
LEAD_NOTIFY_TO=marek@deeptech.pl
LEAD_NOTIFY_FROM=Audomate Website <audomate@veryniceworks.com>

# --- Optional: also store leads in Supabase (server-only) ---
# Run supabase/migrations/001_audomate_leads.sql, then set both.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
